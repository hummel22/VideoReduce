# Sample environment configuration for VideoReduce backend
# Copy this file to `.env` and adjust values for your environment.

# Database configuration
VIDEOR_DATABASE_URL=sqlite:///backend/data/videoreduce.db

# Directories for input and output media
VIDEOR_INPUT_DIR=backend/data/input
VIDEOR_OUTPUT_DIR=backend/data/output

# Queue polling interval (in seconds)
VIDEOR_POLL_INTERVAL_SECONDS=30

# Authentication settings
VIDEOR_JWT_SECRET_KEY=change-me
VIDEOR_JWT_ALGORITHM=HS256
VIDEOR_JWT_EXPIRATION_MINUTES=120

# Dashboard admin credentials
VIDEOR_ADMIN_USERNAME=admin
VIDEOR_ADMIN_PASSWORD=changeme

# Path to HandBrakeCLI binary
VIDEOR_HANDBRAKE_CLI_PATH=HandBrakeCLI

# Number of days to retain queue logs
VIDEOR_QUEUE_LOG_RETENTION=90
